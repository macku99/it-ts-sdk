    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --root ../.. packages/harness"
  },
  "dependencies": {
    "zod": "^4.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
