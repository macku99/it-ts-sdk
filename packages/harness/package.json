{
  "name": "@it-core/harness",
  "version": "0.1.0",
  "description": "Headless agent-CLI runner — spawns claude/codex/grok and validates their output against a schema",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
